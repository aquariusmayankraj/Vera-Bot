# Backend environment. Never upload a real .env to Netlify or commit secrets.
TEAM_NAME=My Vera Bot
TEAM_MEMBERS=Your Full Name
CONTACT_EMAIL=you@example.com
SUBMITTED_AT=
PORT=8080
DB_PATH=data/vera.sqlite3
# Blank => DB_PATH + .demo (separate sandbox database).
DEMO_DB_PATH=
DEMO_ENABLED=true
DOCS_ENABLED=true
LOG_LEVEL=info
# Public synthetic-data demo: * is convenient. After Netlify deploy,
# replace * with your exact origin, e.g. https://your-site.netlify.app
# Multiple origins: comma separated, no trailing slash, no paths.
CORS_ORIGINS=*
# Optional: link on the backend landing page. This does not control CORS.
FRONTEND_URL=
MIN_GAP_SECONDS=1800
MAX_UNANSWERED=3
STATE_TTL_HOURS=24
# Leave blank for public judge access unless your judge supports bearer auth.
# Enter a configured token only in the frontend Settings password field.
API_TOKEN=
# Destructive teardown is DISABLED until this separate secret is configured.
TEARDOWN_TOKEN=
