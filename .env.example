# Change these three fields before submission.
TEAM_NAME=My Vera Bot
TEAM_MEMBERS=Your Full Name
CONTACT_EMAIL=you@example.com
# Optional: an ISO timestamp for your actual submission; otherwise startup time.
SUBMITTED_AT=

PORT=8080
HOST_PORT=8080
DB_PATH=data/vera.sqlite3
LOG_LEVEL=info
DOCS_ENABLED=true
MIN_GAP_SECONDS=1800
MAX_UNANSWERED=3
STATE_TTL_HOURS=24

# Leave blank for the challenge unless the evaluator supports your auth header.
# These are not LLM keys. API_TOKEN protects write endpoints when configured.
API_TOKEN=
# Optional separate token for the destructive /v1/teardown endpoint.
TEARDOWN_TOKEN=

# OPTIONAL scorer only. The bot itself never calls an LLM or needs an API key.
JUDGE_LLM_PROVIDER=openai
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=
JUDGE_OLLAMA_URL=http://localhost:11434
